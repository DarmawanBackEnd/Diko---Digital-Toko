{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @kasir-pintar/core build && pnpm --filter @kasir-pintar/kasir build",
  "outputDirectory": "apps/kasir/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
